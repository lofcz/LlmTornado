@using LlmTornado.Cli.Core.Skills
@using LlmTornado.Cli.Blazor
@using Microsoft.AspNetCore.Components.Forms

<div class="settings-section">
    <p class="settings-section__desc">
        Skills are loaded from project-local (<code>@_projectDir</code>) and
        global (<code>@_globalDir</code>) directories.
    </p>

    <div class="settings-section__actions" style="margin-bottom: 16px;">
        <button class="tornado-chat__btn" @onclick="RefreshSkills">
            ↻ Refresh Skills
        </button>
        <label class="tornado-chat__btn tornado-chat__btn--primary" style="cursor: pointer;">
            📂 Import Skill
            <InputFile OnChange="HandleImport" style="display:none" accept=".md,.zip" />
        </label>
    </div>

    @if (_skills.Count == 0)
    {
        <p class="settings-section__empty">No skills found.</p>
    }
    else
    {
        @foreach (var skill in _skills)
        {
            bool isExpanded = _expandedSkill == skill.Name;

            <div class="settings-card @(isExpanded ? "settings-card--expanded" : "") @(!skill.Enabled ? "settings-card--disabled" : "")">
                <div class="settings-card__header" @onclick="() => ToggleExpand(skill)">
                    <div class="settings-card__header-left">
                        <strong>@skill.Name</strong>
                        <span class="status-badge">@skill.Source</span>
                        @if (!string.IsNullOrWhiteSpace(skill.Description))
                        {
                            <span class="settings-card__desc">@skill.Description</span>
                        }
                    </div>
                    <div class="settings-card__header-right">
                        @if (skill.AllowedTools.Count > 0)
                        {
                            <span class="settings-card__tool-count">@skill.AllowedTools.Count tools</span>
                        }
                        <label class="toggle" @onclick:stopPropagation="true">
                            <input type="checkbox"
                                   checked="@skill.Enabled"
                                   @onchange="e => HandleToggle(skill, (bool)(e.Value ?? false))" />
                            <span class="toggle__slider"></span>
                        </label>
                        <span class="settings-card__chevron">@(isExpanded ? "▾" : "▸")</span>
                    </div>
                </div>

                @if (isExpanded)
                {
                    <div class="settings-card__body">
                        <div class="settings-form__field">
                            <label>
                                SKILL.md
                                <span class="settings-card__path">@skill.SkillMdPath</span>
                            </label>
                            <textarea rows="16" class="settings-form__code"
                                      @bind="_editContent"></textarea>
                        </div>

                        @if (skill.Scripts.Count > 0)
                        {
                            <div class="settings-form__field">
                                <label>Scripts</label>
                                <div class="settings-card__tag-list">
                                    @foreach (var script in skill.Scripts)
                                    {
                                        <span class="status-badge">@script.FileName</span>
                                    }
                                </div>
                            </div>
                        }

                        @if (skill.References.Count > 0)
                        {
                            <div class="settings-form__field">
                                <label>References</label>
                                <div class="settings-card__tag-list">
                                    @foreach (var reference in skill.References)
                                    {
                                        <span class="status-badge">@Path.GetFileName(reference)</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="settings-card__actions">
                            <button class="tornado-chat__btn tornado-chat__btn--primary"
                                    @onclick="SaveSkillFile" disabled="@_isSaving">
                                @(_isSaving ? "Saving..." : "Save")
                            </button>
                            <button class="tornado-chat__btn" @onclick="CancelEdit">Cancel</button>
                        </div>

                        @if (_saveMessage is not null)
                        {
                            <div class="settings-card__test-result settings-card__test-result--ok">
                                @_saveMessage
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

    @if (_importMessage is not null)
    {
        <div class="settings-card__test-result settings-card__test-result--ok" style="margin-top: 12px;">
            @_importMessage
        </div>
    }
</div>

@code {
    [Inject] public ISettingsController Settings { get; set; } = default!;

    private List<Skill> _skills = [];
    private string _projectDir = "";
    private string _globalDir = "";
    private string? _expandedSkill;
    private string _editContent = "";
    private bool _isSaving;
    private string? _saveMessage;

    protected override void OnInitialized()
    {
        _projectDir = Settings.GetSkillsDirectory();
        _globalDir = Settings.GetGlobalSkillsDirectory();
        LoadSkills();
    }

    private void LoadSkills()
    {
        _skills = Settings.GetAllSkills();
    }

    private void HandleToggle(Skill skill, bool enabled)
    {
        Settings.SetSkillEnabled(skill.Name, enabled);
        // Refresh to get the updated state
        LoadSkills();
        StateHasChanged();
    }

    private void ToggleExpand(Skill skill)
    {
        if (_expandedSkill == skill.Name)
        {
            _expandedSkill = null;
            _saveMessage = null;
        }
        else
        {
            _expandedSkill = skill.Name;
            _saveMessage = null;
            _editContent = Settings.ReadSkillFile(skill.Name) ?? "";
        }
    }

    private void CancelEdit()
    {
        _expandedSkill = null;
        _saveMessage = null;
    }

    private async Task SaveSkillFile()
    {
        if (_expandedSkill is null) return;
        _isSaving = true;
        _saveMessage = null;
        StateHasChanged();

        try
        {
            await Settings.SaveSkillFileAsync(_expandedSkill, _editContent);
            _saveMessage = "Saved successfully.";
            // Refresh skills to pick up metadata changes
            Settings.RefreshSkills();
            LoadSkills();
        }
        catch (Exception ex)
        {
            _saveMessage = $"Error saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void RefreshSkills()
    {
        Settings.RefreshSkills();
        LoadSkills();
        _importMessage = null;
        StateHasChanged();
    }

    private string? _importMessage;

    private async Task HandleImport(InputFileChangeEventArgs e)
    {
        _importMessage = null;
        StateHasChanged();

        try
        {
            await using Stream stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            await Settings.ImportSkillAsync(e.File.Name, stream);
            LoadSkills();
            _importMessage = $"Imported '{e.File.Name}' successfully.";
        }
        catch (Exception ex)
        {
            _importMessage = $"Import failed: {ex.Message}";
        }

        StateHasChanged();
    }
}
