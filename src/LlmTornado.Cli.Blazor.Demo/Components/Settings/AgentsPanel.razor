@using LlmTornado.Cli.Core.Agents
@using LlmTornado.Cli.Core.Skills
@using LlmTornado.Cli.Blazor

<div class="settings-section">
    <p class="settings-section__desc">
        Agent personas define the AI's behavior, system prompt, and available tools.
        Built-in agents ship with the library; custom agents can be created in the
        <code>@_agentsDir</code> directory.
    </p>

    <div class="settings-section__actions" style="margin-bottom: 16px;">
        <button class="tornado-chat__btn" @onclick="RefreshAgents">
            ↻ Refresh Agents
        </button>
        <button class="tornado-chat__btn tornado-chat__btn--primary" @onclick="ShowCreateForm">
            + New Agent
        </button>
    </div>

    @* ── Create New Agent Form ── *@
    @if (_showCreateForm)
    {
        <div class="settings-card settings-card--expanded">
            <div class="settings-card__header">
                <strong>New Agent</strong>
            </div>
            <div class="settings-card__body">
                <div class="settings-form__field">
                    <label>Scope</label>
                    <select class="settings-form__select" @bind="_createScope">
                        <option value="@AgentSource.Custom">Local (project)</option>
                        <option value="@AgentSource.Global">Global (shared)</option>
                    </select>
                </div>
                @RenderAgentForm(_form, false)
                <div class="settings-card__actions">
                    <button class="tornado-chat__btn tornado-chat__btn--primary"
                            @onclick="SaveNewAgent" disabled="@_isSaving">
                        @(_isSaving ? "Saving..." : "Create Agent")
                    </button>
                    <button class="tornado-chat__btn" @onclick="CancelCreate">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* ── Agent List ── *@
    @if (_agents.Count == 0 && !_showCreateForm)
    {
        <p class="settings-section__empty">No agent personas found.</p>
    }
    else
    {
        @foreach (var agent in _agents)
        {
            bool isExpanded = _expandedAgent == agent.Name;
            bool isActive = agent.Name == _activeAgentName;
            bool isCustom = agent.Source is AgentSource.Custom or AgentSource.Global;

            <div class="settings-card @(isExpanded ? "settings-card--expanded" : "") @(isActive ? "settings-card--active" : "")">
                <div class="settings-card__header" @onclick="() => ToggleExpand(agent)">
                    <div class="settings-card__header-left">
                        <strong>@agent.Name</strong>
                        <span class="status-badge @(agent.Source == AgentSource.Global ? "status-badge--global" : agent.Source == AgentSource.Custom ? "status-badge--local" : "")">@agent.Source</span>
                        @if (isActive)
                        {
                            <span class="status-badge status-badge--ok">Active</span>
                        }
                        @if (agent.HasCapabilityCuration)
                        {
                            <span class="status-badge">⚙ Curated</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(agent.Description))
                        {
                            <span class="settings-card__desc">@agent.Description</span>
                        }
                    </div>
                    <div class="settings-card__header-right">
                        @if (!isActive)
                        {
                            <button class="tornado-chat__btn tornado-chat__btn--sm"
                                    @onclick="() => ActivateAgent(agent.Name)"
                                    @onclick:stopPropagation="true">
                                Activate
                            </button>
                        }
                        else
                        {
                            <button class="tornado-chat__btn tornado-chat__btn--sm"
                                    @onclick="DeactivateAgent"
                                    @onclick:stopPropagation="true">
                                Deactivate
                            </button>
                        }
                        <span class="settings-card__chevron">@(isExpanded ? "▾" : "▸")</span>
                    </div>
                </div>

                @if (isExpanded)
                {
                    <div class="settings-card__body">
                        @if (isCustom)
                        {
                            @RenderAgentForm(_form, true)
                            <div class="settings-card__actions">
                                <button class="tornado-chat__btn tornado-chat__btn--primary"
                                        @onclick="() => SaveEditedAgent(agent.Name)" disabled="@_isSaving">
                                    @(_isSaving ? "Saving..." : "Save")
                                </button>
                                <button class="tornado-chat__btn settings-card__btn--danger"
                                        @onclick="() => DeleteAgent(agent.Name)">
                                    🗑 Delete
                                </button>
                                @if (agent.Source == AgentSource.Custom)
                                {
                                    <button class="tornado-chat__btn" @onclick="() => MoveAgent(agent.Name, AgentSource.Global)">
                                        ↗ Move to Global
                                    </button>
                                }
                                else if (agent.Source == AgentSource.Global)
                                {
                                    <button class="tornado-chat__btn" @onclick="() => MoveAgent(agent.Name, AgentSource.Custom)">
                                        ↙ Move to Local
                                    </button>
                                }
                                <button class="tornado-chat__btn" @onclick="CancelExpand">Cancel</button>
                            </div>
                        }
                        else
                        {
                            @* Built-in agents: read-only view *@
                            <div class="settings-form__field">
                                <label>Description</label>
                                <p>@agent.Description</p>
                            </div>
                            <div class="settings-form__field">
                                <label>Instructions (read-only)</label>
                                <pre class="settings-form__pre">@agent.Instructions</pre>
                            </div>
                            @RenderCapabilitySummary(agent)
                            <div class="settings-card__actions">
                                <button class="tornado-chat__btn" @onclick="CancelExpand">Close</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

    @if (_statusMessage is not null)
    {
        <div class="settings-card__test-result settings-card__test-result--ok" style="margin-top: 12px;">
            @_statusMessage
        </div>
    }

    @if (_activationWarning is not null)
    {
        <div class="settings-card__test-result settings-card__test-result--fail" style="margin-top: 12px;">
            <strong>⚠ Dependency warnings for '@_activeAgentName':</strong>
            @((MarkupString)FormatDependencyWarning(_activationWarning))
        </div>
    }

    @if (_pendingMoveReport is not null)
    {
        <div class="settings-card" style="margin-top: 12px; border-color: #f59e0b;">
            <div class="settings-card__body">
                <strong>⚠ Moving '@_pendingMoveName' to @_pendingMoveScope</strong>
                <p style="margin: 8px 0; font-size: 13px;">This agent references resources that may not be available in the target scope:</p>
                @((MarkupString)FormatDependencyWarning(_pendingMoveReport))
                <div class="settings-card__actions" style="margin-top: 12px;">
                    <button class="tornado-chat__btn tornado-chat__btn--primary" @onclick="ConfirmMove">
                        Move Anyway
                    </button>
                    <button class="tornado-chat__btn" @onclick="CancelMove">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Inject] public ISettingsController Settings { get; set; } = default!;
    [Inject] public IChatUiController Controller { get; set; } = default!;

    private List<AgentDefinition> _agents = [];
    private string? _activeAgentName;
    private string _agentsDir = "";
    private string? _expandedAgent;
    private bool _showCreateForm;
    private bool _isSaving;
    private string? _statusMessage;
    private AgentSource _createScope = AgentSource.Custom;
    private AgentDependencyReport? _activationWarning;

    // Pending move confirmation state
    private AgentDependencyReport? _pendingMoveReport;
    private string? _pendingMoveName;
    private AgentSource _pendingMoveScope;

    // Available tools and skills for the pickers
    private List<ToolInfo> _mcpTools = [];
    private List<Skill> _availableSkills = [];

    // Form state
    private AgentFormModel _form = new();

    protected override void OnInitialized()
    {
        _agentsDir = Settings.GetAgentsDirectory();
        LoadAgents();
    }

    private void LoadAgents()
    {
        _agents = Settings.GetAllAgentDefinitions();
        _activeAgentName = Settings.GetActiveAgentName();
        _availableSkills = Settings.GetAllSkills();

        // MCP tools that are NOT owned by any skill
        HashSet<string> skillToolNames = new(StringComparer.OrdinalIgnoreCase);
        foreach (var skill in _availableSkills)
            foreach (var t in skill.AllowedTools)
                skillToolNames.Add(t);

        _mcpTools = Settings.GetAvailableTools()
            .Where(t => !skillToolNames.Contains(t.Name))
            .ToList();
    }

    // ── Activate / Deactivate ──

    private async Task ActivateAgent(string name)
    {
        await Controller.SelectAgentAsync(name);
        _activeAgentName = name;

        // Check for missing dependencies and surface warnings
        AgentDependencyReport report = Settings.AnalyzeAgentDependencies(name);
        _activationWarning = report.HasMissingDependencies ? report : null;

        StateHasChanged();
    }

    private async Task DeactivateAgent()
    {
        await Controller.SelectAgentAsync(null);
        _activeAgentName = null;
        _activationWarning = null;
        StateHasChanged();
    }

    // ── Expand / Collapse ──

    private void ToggleExpand(AgentDefinition agent)
    {
        if (_expandedAgent == agent.Name)
        {
            _expandedAgent = null;
            _statusMessage = null;
        }
        else
        {
            _expandedAgent = agent.Name;
            _showCreateForm = false;
            _statusMessage = null;
            PopulateForm(agent);
        }
    }

    private void CancelExpand()
    {
        _expandedAgent = null;
        _statusMessage = null;
    }

    // ── Create ──

    private void ShowCreateForm()
    {
        _showCreateForm = true;
        _expandedAgent = null;
        _statusMessage = null;
        _form = new AgentFormModel();
    }

    private void CancelCreate()
    {
        _showCreateForm = false;
        _statusMessage = null;
    }

    private async Task SaveNewAgent()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) return;
        _isSaving = true;
        StateHasChanged();

        try
        {
            await Settings.CreateAgentAsync(
                _form.Name, _form.Description, _form.Instructions,
                GetSelectedList(_form.EnabledSkills),
                disabledSkills: null,
                GetSelectedList(_form.EnabledTools),
                disabledTools: null,
                _createScope);

            _showCreateForm = false;
            _statusMessage = $"Agent '{_form.Name}' created.";
            LoadAgents();
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    // ── Edit / Delete ──

    private async Task SaveEditedAgent(string name)
    {
        _isSaving = true;
        StateHasChanged();

        try
        {
            await Settings.UpdateAgentAsync(
                name, _form.Description, _form.Instructions,
                GetSelectedList(_form.EnabledSkills),
                disabledSkills: null,
                GetSelectedList(_form.EnabledTools),
                disabledTools: null);

            _expandedAgent = null;
            _statusMessage = $"Agent '{name}' saved.";
            LoadAgents();
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAgent(string name)
    {
        await Settings.DeleteAgentAsync(name);
        _expandedAgent = null;
        _statusMessage = $"Agent '{name}' deleted.";
        LoadAgents();
        StateHasChanged();
    }

    private void RefreshAgents()
    {
        Settings.RefreshAgents();
        LoadAgents();
        StateHasChanged();
    }

    // ── Form rendering ──

    private RenderFragment RenderAgentForm(AgentFormModel form, bool isEdit) => __builder =>
    {
        <div class="settings-form__field">
            <label>Name</label>
            <input type="text" @bind="form.Name" placeholder="my-agent"
                   disabled="@isEdit" />
        </div>

        <div class="settings-form__field">
            <label>Description</label>
            <input type="text" @bind="form.Description"
                   placeholder="A helpful assistant..." />
        </div>

        <div class="settings-form__field">
            <label>Instructions</label>
            <textarea @bind="form.Instructions" rows="8"
                      placeholder="You are a helpful AI assistant..."></textarea>
        </div>

        @* ── Skills + per-skill tools ── *@
        @if (_availableSkills.Count > 0)
        {
            <div class="settings-form__field">
                <label>Skills <span class="settings-form__hint">— check to enable, then pick tools</span></label>
                <div class="settings-card__skill-list">
                    @foreach (var skill in _availableSkills)
                    {
                        bool isEnabled = form.EnabledSkills.Contains(skill.Name);
                        <div class="settings-card__skill-group @(isEnabled ? "settings-card__skill-group--active" : "")">
                            <label class="settings-card__picker-item">
                                <input type="checkbox" checked="@isEnabled"
                                       @onchange="e => ToggleSkill(form, skill, (bool)(e.Value ?? false))" />
                                <strong>@skill.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(skill.Description))
                                {
                                    <span class="settings-card__picker-tool-desc">@skill.Description</span>
                                }
                            </label>

                            @if (isEnabled && skill.AllowedTools.Count > 0)
                            {
                                <div class="settings-card__skill-tools">
                                    @foreach (var toolName in skill.AllowedTools)
                                    {
                                        bool toolEnabled = form.EnabledTools.Contains(toolName);
                                        <label class="settings-card__picker-item">
                                            <input type="checkbox" checked="@toolEnabled"
                                                   @onchange="e => ToggleInSet(form.EnabledTools, toolName, (bool)(e.Value ?? false))" />
                                            <span class="settings-card__picker-tool-name">@toolName</span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* ── MCP Tools (not owned by any skill) ── *@
        @if (_mcpTools.Count > 0)
        {
            <div class="settings-form__field">
                <label>MCP Tools <span class="settings-form__hint">— check to enable</span></label>
                <div class="settings-card__picker settings-card__picker--tools">
                    @foreach (var tool in _mcpTools)
                    {
                        bool isEnabled = form.EnabledTools.Contains(tool.Name);
                        <label class="settings-card__picker-item">
                            <input type="checkbox" checked="@isEnabled"
                                   @onchange="e => ToggleInSet(form.EnabledTools, tool.Name, (bool)(e.Value ?? false))" />
                            <span class="settings-card__picker-tool-name">@tool.Name</span>
                            @if (!string.IsNullOrWhiteSpace(tool.Description))
                            {
                                <span class="settings-card__picker-tool-desc">@tool.Description</span>
                            }
                        </label>
                    }
                </div>
            </div>
        }
    };

    private RenderFragment RenderCapabilitySummary(AgentDefinition agent) => __builder =>
    {
        @if (agent.EnabledSkills.Count > 0)
        {
            <div class="settings-form__field">
                <label>Enabled Skills</label>
                <div class="settings-card__tag-list">
                    @foreach (var s in agent.EnabledSkills) { <span class="status-badge">@s</span> }
                </div>
            </div>
        }
        @if (agent.EnabledTools.Count > 0)
        {
            <div class="settings-form__field">
                <label>Enabled Tools</label>
                <div class="settings-card__tag-list">
                    @foreach (var t in agent.EnabledTools) { <span class="status-badge">@t</span> }
                </div>
            </div>
        }
    };

    // ── Helpers ──

    private void PopulateForm(AgentDefinition agent)
    {
        _form = new AgentFormModel
        {
            Name = agent.Name,
            Description = agent.Description,
            Instructions = agent.Instructions,
            EnabledSkills = [.. agent.EnabledSkills],
            EnabledTools = [.. agent.EnabledTools],
        };
    }

    private static void ToggleInSet(HashSet<string> set, string item, bool add)
    {
        if (add) set.Add(item);
        else set.Remove(item);
    }

    /// <summary>
    /// When a skill is enabled, auto-whitelist all its tools.
    /// When disabled, remove its tools from the whitelist.
    /// </summary>
    private static void ToggleSkill(AgentFormModel form, Skill skill, bool enabled)
    {
        if (enabled)
        {
            form.EnabledSkills.Add(skill.Name);
            foreach (var t in skill.AllowedTools)
                form.EnabledTools.Add(t);
        }
        else
        {
            form.EnabledSkills.Remove(skill.Name);
            foreach (var t in skill.AllowedTools)
                form.EnabledTools.Remove(t);
        }
    }

    private static List<string>? GetSelectedList(HashSet<string> set)
        => set.Count > 0 ? [.. set] : null;

    private async Task MoveAgent(string agentName, AgentSource targetScope)
    {
        try
        {
            // Check dependencies before moving
            if (targetScope == AgentSource.Global)
            {
                AgentDependencyReport report = Settings.AnalyzeAgentDependencies(agentName);
                if (report.HasLocalOnlyDependencies || report.HasMissingDependencies)
                {
                    _pendingMoveReport = report;
                    _pendingMoveName = agentName;
                    _pendingMoveScope = targetScope;
                    StateHasChanged();
                    return;
                }
            }

            await ExecuteMove(agentName, targetScope);
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to move agent: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ConfirmMove()
    {
        if (_pendingMoveName is not null)
        {
            await ExecuteMove(_pendingMoveName, _pendingMoveScope);
        }
        ClearPendingMove();
    }

    private void CancelMove()
    {
        ClearPendingMove();
        StateHasChanged();
    }

    private void ClearPendingMove()
    {
        _pendingMoveReport = null;
        _pendingMoveName = null;
    }

    private async Task ExecuteMove(string agentName, AgentSource targetScope)
    {
        await Settings.MoveAgentAsync(agentName, targetScope);
        _expandedAgent = null;
        _statusMessage = $"Agent '{agentName}' moved to {targetScope}.";
        ClearPendingMove();
        LoadAgents();
        StateHasChanged();
    }

    private static string FormatDependencyWarning(AgentDependencyReport report)
    {
        List<string> parts = [];
        if (report.LocalOnlySkills.Count > 0)
            parts.Add($"<br/>• <strong>Local-only skills:</strong> {string.Join(", ", report.LocalOnlySkills)}");
        if (report.MissingSkills.Count > 0)
            parts.Add($"<br/>• <strong>Missing skills:</strong> {string.Join(", ", report.MissingSkills)}");
        if (report.LocalOnlyTools.Count > 0)
            parts.Add($"<br/>• <strong>Local-only MCP tools:</strong> {string.Join(", ", report.LocalOnlyTools)}");
        if (report.MissingTools.Count > 0)
            parts.Add($"<br/>• <strong>Missing MCP tools:</strong> {string.Join(", ", report.MissingTools)}");
        return string.Concat(parts);
    }

    private sealed class AgentFormModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Instructions { get; set; } = "";
        public HashSet<string> EnabledSkills { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public HashSet<string> EnabledTools { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }
}
