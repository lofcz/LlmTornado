@using LlmTornado.Cli.Blazor

<div class="settings-section">
    <p class="settings-section__desc">
        Working directory affects where the agent looks for skills, agents, and MCP
        configuration relative to the project root. Changing this reloads all
        directory-dependent resources.
    </p>

    <p class="settings-section__desc" style="margin-top: 8px;">
        The selected working directory is automatically allowed for filesystem and terminal access,
        including all subfolders. Use the sandbox defaults below to add extra allowed roots or
        command rules for each rebuilt session.
    </p>

    <div class="settings-form">
        <div class="settings-form__field">
            <label>Working Directory</label>
            <div style="display: flex; gap: 8px; align-items: flex-start;">
                <input type="text"
                       @bind="_inputPath"
                       @bind:event="oninput"
                       placeholder="Enter absolute path..."
                       style="flex: 1; font-family: 'Consolas', monospace; font-size: 12px;" />
                <button class="tornado-chat__btn"
                        @onclick="ToggleBrowser"
                        title="Browse for folder">
                    📂 Browse
                </button>
                <button class="tornado-chat__btn tornado-chat__btn--primary"
                        @onclick="ApplyAsync"
                        disabled="@_isApplying">
                    @(_isApplying ? "Applying…" : "Apply")
                </button>
            </div>
        </div>

        @if (_showBrowser)
        {
            <div class="folder-browser">
                <div class="folder-browser__header">
                    <span class="folder-browser__path" title="@_browserPath">@_browserPath</span>
                    <button class="tornado-chat__btn tornado-chat__btn--sm"
                            @onclick="BrowserNavigateUp"
                            disabled="@(Path.GetDirectoryName(_browserPath) is null)"
                            title="Go to parent directory">
                        ↑ Up
                    </button>
                    <button class="tornado-chat__btn tornado-chat__btn--sm tornado-chat__btn--primary"
                            @onclick="BrowserSelect"
                            title="Use this directory">
                        ✓ Select
                    </button>
                </div>

                @if (_browserError is not null)
                {
                    <p class="settings-section__error" style="margin: 8px 0 0; font-size: 12px;">@_browserError</p>
                }

                @if (_browserDrives is not null)
                {
                    <div class="folder-browser__list">
                        @foreach (string drive in _browserDrives)
                        {
                            <div class="folder-browser__item" @onclick="() => BrowserNavigateTo(drive)">
                                <span class="folder-browser__icon">💾</span>
                                <span>@drive</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="folder-browser__list">
                        @if (_browserDirs is not null)
                        {
                            @foreach (string dir in _browserDirs)
                            {
                                <div class="folder-browser__item" @onclick="() => BrowserNavigateTo(dir)">
                                    <span class="folder-browser__icon">📁</span>
                                    <span>@Path.GetFileName(dir)</span>
                                </div>
                            }

                            @if (_browserDirs.Count == 0)
                            {
                                <div class="folder-browser__empty">No subdirectories</div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <p class="@(_isError ? "settings-section__error" : "settings-section__success")"
           style="margin-top: 12px; font-size: 13px;">
            @_statusMessage
        </p>
    }

    <div style="margin-top: 20px;">
        <h3 style="font-size: 14px; margin: 0 0 12px;">Sandbox Defaults</h3>
        <div class="settings-form">
            <div class="settings-form__field">
                <label>Filesystem Whitelist</label>
                <textarea rows="4"
                          @bind="_filesystemWhitelistText"
                          @bind:event="oninput"
                          placeholder="One absolute path per line"></textarea>
                <small>Extra directories allowed for file tools in addition to the working directory subtree.</small>
            </div>

            <div class="settings-form__field">
                <label>Terminal Directory Whitelist</label>
                <textarea rows="4"
                          @bind="_terminalWhitelistText"
                          @bind:event="oninput"
                          placeholder="One absolute path per line"></textarea>
                <small>Extra directories where terminal commands may start, beyond the working directory subtree.</small>
            </div>

            <div class="settings-form__field">
                <label>Allowed Commands</label>
                <textarea rows="3"
                          @bind="_allowedCommandsText"
                          @bind:event="oninput"
                          placeholder="git&#10;dotnet&#10;npm"></textarea>
                <small>Optional allow-list. Leave empty to allow any command not explicitly blocked.</small>
            </div>

            <div class="settings-form__field">
                <label>Blocked Commands</label>
                <textarea rows="3"
                          @bind="_blockedCommandsText"
                          @bind:event="oninput"
                          placeholder="rm&#10;del"></textarea>
                <small>Blocked commands always win over the allow-list.</small>
            </div>

            <div class="settings-card__actions">
                <button class="tornado-chat__btn tornado-chat__btn--primary"
                        @onclick="ApplySandboxAsync"
                        disabled="@_isApplyingSandbox">
                    @(_isApplyingSandbox ? "Saving…" : "Save Sandbox Defaults")
                </button>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <h3 style="font-size: 14px; margin: 0 0 12px;">Resolved Paths</h3>
        <table class="settings-table">
            <thead>
                <tr>
                    <th>Resource</th>
                    <th>Path</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Skills Directory</td>
                    <td class="settings-table__mono">@_skillsDir</td>
                    <td>
                        @if (Directory.Exists(_skillsDir))
                        {
                            <span class="status-badge status-badge--ok">exists</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--missing">not found</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td>Agents Directory</td>
                    <td class="settings-table__mono">@_agentsDir</td>
                    <td>
                        @if (Directory.Exists(_agentsDir))
                        {
                            <span class="status-badge status-badge--ok">exists</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--missing">not found</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td>MCP Config</td>
                    <td class="settings-table__mono">@_mcpPath</td>
                    <td>
                        @if (File.Exists(_mcpPath))
                        {
                            <span class="status-badge status-badge--ok">exists</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--missing">not found</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div style="margin-top: 20px;">
        <h3 style="font-size: 14px; margin: 0 0 12px;">Global Paths</h3>
        <table class="settings-table">
            <thead>
                <tr>
                    <th>Resource</th>
                    <th>Path</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Global Skills Directory</td>
                    <td class="settings-table__mono">@_globalSkillsDir</td>
                    <td>
                        @if (Directory.Exists(_globalSkillsDir))
                        {
                            <span class="status-badge status-badge--ok">exists</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--missing">not found</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td>Global Agents Directory</td>
                    <td class="settings-table__mono">@_globalAgentsDir</td>
                    <td>
                        @if (Directory.Exists(_globalAgentsDir))
                        {
                            <span class="status-badge status-badge--ok">exists</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--missing">not found</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td>Global MCP Config</td>
                    <td class="settings-table__mono">@_globalMcpPath</td>
                    <td>
                        @if (File.Exists(_globalMcpPath))
                        {
                            <span class="status-badge status-badge--ok">exists</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--missing">not found</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    [Inject] public ISettingsController Settings { get; set; } = default!;

    private string _inputPath = "";
    private string _skillsDir = "";
    private string _agentsDir = "";
    private string _mcpPath = "";
    private string _globalSkillsDir = "";
    private string _globalAgentsDir = "";
    private string _globalMcpPath = "";
    private string? _statusMessage;
    private bool _isError;
    private bool _isApplying;
    private bool _isApplyingSandbox;
    private string _filesystemWhitelistText = "";
    private string _terminalWhitelistText = "";
    private string _allowedCommandsText = "";
    private string _blockedCommandsText = "";

    // Folder browser state
    private bool _showBrowser;
    private string _browserPath = "";
    private List<string>? _browserDirs;
    private List<string>? _browserDrives;
    private string? _browserError;

    protected override void OnInitialized()
    {
        _inputPath = Settings.GetWorkingDirectory();
        RefreshResolvedPaths();
        RefreshSandboxSettings();
    }

    private void ToggleBrowser()
    {
        _showBrowser = !_showBrowser;
        if (_showBrowser)
        {
            // Start browsing from the current input path, or fall back to current directory
            string startPath = _inputPath.Trim();
            if (!Directory.Exists(startPath))
                startPath = Settings.GetWorkingDirectory();
            if (!Directory.Exists(startPath))
                startPath = Environment.CurrentDirectory;

            BrowserNavigateTo(startPath);
        }
    }

    private void BrowserNavigateTo(string path)
    {
        _browserError = null;
        _browserDrives = null;
        _browserDirs = null;

        try
        {
            path = Path.GetFullPath(path);
            if (!Directory.Exists(path))
            {
                _browserError = $"Directory not found: {path}";
                return;
            }

            _browserPath = path;
            _browserDirs = Directory.GetDirectories(path)
                .OrderBy(d => Path.GetFileName(d), StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (UnauthorizedAccessException)
        {
            _browserPath = path;
            _browserError = "Access denied.";
            _browserDirs = [];
        }
        catch (Exception ex)
        {
            _browserPath = path;
            _browserError = ex.Message;
            _browserDirs = [];
        }
    }

    private void BrowserNavigateUp()
    {
        string? parent = Path.GetDirectoryName(_browserPath);
        if (parent is not null)
        {
            BrowserNavigateTo(parent);
        }
        else
        {
            // At a root — show drive list (Windows)
            _browserError = null;
            _browserDirs = null;
            _browserPath = "Computer";
            try
            {
                _browserDrives = DriveInfo.GetDrives()
                    .Where(d => d.IsReady)
                    .Select(d => d.RootDirectory.FullName)
                    .ToList();
            }
            catch (Exception ex)
            {
                _browserError = ex.Message;
                _browserDrives = [];
            }
        }
    }

    private void BrowserSelect()
    {
        if (_browserPath is not "Computer")
        {
            _inputPath = _browserPath;
            _showBrowser = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputPath))
        {
            _statusMessage = "Path cannot be empty.";
            _isError = true;
            return;
        }

        _isApplying = true;
        _statusMessage = null;
        StateHasChanged();

        try
        {
            await Settings.ChangeWorkingDirectoryAsync(_inputPath.Trim());
            _inputPath = Settings.GetWorkingDirectory();
            RefreshResolvedPaths();
            _statusMessage = $"Working directory changed to {_inputPath}";
            _isError = false;
        }
        catch (DirectoryNotFoundException ex)
        {
            _statusMessage = ex.Message;
            _isError = true;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isApplying = false;
        }
    }

    private async Task ApplySandboxAsync()
    {
        _isApplyingSandbox = true;
        _statusMessage = null;
        StateHasChanged();

        try
        {
            await Settings.UpdateMcpSandboxSettingsAsync(new McpSandboxSettings(
                ParseLines(_filesystemWhitelistText),
                ParseLines(_terminalWhitelistText),
                ParseLines(_allowedCommandsText),
                ParseLines(_blockedCommandsText)));

            RefreshSandboxSettings();
            _statusMessage = "Sandbox defaults updated.";
            _isError = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isApplyingSandbox = false;
        }
    }

    private void RefreshResolvedPaths()
    {
        _skillsDir = Settings.GetSkillsDirectory();
        _agentsDir = Settings.GetAgentsDirectory();
        _mcpPath = Settings.GetMcpConfigPath();
        _globalSkillsDir = Settings.GetGlobalSkillsDirectory();
        _globalAgentsDir = Settings.GetGlobalAgentsDirectory();
        _globalMcpPath = Settings.GetGlobalMcpConfigPath();
    }

    private void RefreshSandboxSettings()
    {
        McpSandboxSettings sandbox = Settings.GetMcpSandboxSettings();
        _filesystemWhitelistText = JoinLines(sandbox.FilesystemWhitelist);
        _terminalWhitelistText = JoinLines(sandbox.TerminalDirectoryWhitelist);
        _allowedCommandsText = JoinLines(sandbox.AllowedCommands);
        _blockedCommandsText = JoinLines(sandbox.BlockedCommands);
    }

    private static List<string> ParseLines(string? text)
        => (text ?? string.Empty)
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => line.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static string JoinLines(IEnumerable<string>? values)
        => values is null ? string.Empty : string.Join(Environment.NewLine, values);
}
