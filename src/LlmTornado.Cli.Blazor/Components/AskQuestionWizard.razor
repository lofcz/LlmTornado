@using LlmTornado.Cli.Blazor.Models
@using LlmTornado.Cli.Core.Interactions

<div class="tool-approval ask-question">
    <div class="tool-approval__header">
        <span class="tool-approval__icon">?</span>
        <span class="tool-approval__title">@Request.Interaction.Title</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Request.Interaction.Message))
    {
        <p class="tool-approval__message">@Request.Interaction.Message</p>
    }

    @if (CurrentQuestion is not null)
    {
        <div class="ask-question__progress">Question @(CurrentIndex + 1) of @Request.Interaction.Questions.Count</div>
        <div class="ask-question__question">@CurrentQuestion.Prompt</div>

        @if (!string.IsNullOrWhiteSpace(CurrentQuestion.Description))
        {
            <div class="ask-question__description">@CurrentQuestion.Description</div>
        }

        @switch (CurrentQuestion.Type)
        {
            case InteractiveQuestionInputType.SingleChoice:
                <div class="ask-question__options">
                    @foreach (InteractiveQuestionOption option in CurrentQuestion.Options)
                    {
                        <label class="ask-question__option">
                            <input type="radio"
                                   name="@CurrentQuestion.Key"
                                   checked="@(GetSingleChoiceSelection(CurrentQuestion.Key) == option.Value)"
                                   @onchange="() => SetSingleChoiceSelection(CurrentQuestion.Key, option.Value)" />
                            <span>@option.Label</span>
                        </label>
                    }

                    @if (CurrentQuestion.AllowCustomAnswer)
                    {
                        <label class="ask-question__option">
                            <input type="radio"
                                   name="@CurrentQuestion.Key"
                                   checked="@(GetSingleChoiceSelection(CurrentQuestion.Key) == CustomSelectionToken)"
                                   @onchange="() => SetSingleChoiceSelection(CurrentQuestion.Key, CustomSelectionToken)" />
                            <span>Custom answer</span>
                        </label>

                        @if (GetSingleChoiceSelection(CurrentQuestion.Key) == CustomSelectionToken)
                        {
                            <input class="ask-question__input"
                                   value="@GetCustomValue(CurrentQuestion.Key)"
                                   @oninput="e => SetCustomValue(CurrentQuestion.Key, e.Value?.ToString())"
                                   placeholder="@(CurrentQuestion.Placeholder ?? "Enter a custom answer")" />
                        }
                    }
                </div>
                break;

            case InteractiveQuestionInputType.MultiSelect:
                <div class="ask-question__options">
                    @foreach (InteractiveQuestionOption option in CurrentQuestion.Options)
                    {
                        <label class="ask-question__option">
                            <input type="checkbox"
                                   checked="@IsMultiSelectChecked(CurrentQuestion.Key, option.Value)"
                                   @onchange="e => SetMultiSelectOption(CurrentQuestion.Key, option.Value, e.Value is bool selected && selected)" />
                            <span>@option.Label</span>
                        </label>
                    }

                    @if (CurrentQuestion.AllowCustomAnswer)
                    {
                        <input class="ask-question__input"
                               value="@GetCustomValue(CurrentQuestion.Key)"
                               @oninput="e => SetCustomValue(CurrentQuestion.Key, e.Value?.ToString())"
                               placeholder="@(CurrentQuestion.Placeholder ?? "Optional custom answer")" />
                    }
                </div>
                break;

            case InteractiveQuestionInputType.YesNo:
                <div class="ask-question__options ask-question__options--inline">
                    <label class="ask-question__option">
                        <input type="radio"
                               name="@CurrentQuestion.Key"
                               checked="@(GetYesNoAnswer(CurrentQuestion.Key) == true)"
                               @onchange="() => SetYesNoAnswer(CurrentQuestion.Key, true)" />
                        <span>Yes</span>
                    </label>
                    <label class="ask-question__option">
                        <input type="radio"
                               name="@CurrentQuestion.Key"
                               checked="@(GetYesNoAnswer(CurrentQuestion.Key) == false)"
                               @onchange="() => SetYesNoAnswer(CurrentQuestion.Key, false)" />
                        <span>No</span>
                    </label>
                </div>
                break;

            case InteractiveQuestionInputType.Number:
                <input class="ask-question__input"
                       type="number"
                       value="@GetNumberValue(CurrentQuestion.Key)"
                       @oninput="e => SetNumberValue(CurrentQuestion.Key, e.Value?.ToString())"
                       placeholder="@(CurrentQuestion.Placeholder ?? "Enter a number")" />
                break;

            default:
                <textarea class="tornado-chat__textarea ask-question__textarea"
                          rows="3"
                          value="@GetTextValue(CurrentQuestion.Key)"
                          @oninput="e => SetTextValue(CurrentQuestion.Key, e.Value?.ToString())"
                          placeholder="@(CurrentQuestion.Placeholder ?? "Type your answer")"></textarea>
                break;
        }

        @if (!string.IsNullOrWhiteSpace(_validationError))
        {
            <div class="ask-question__error">@_validationError</div>
        }

        <div class="tool-approval__actions">
            <button class="tornado-chat__btn"
                    @onclick="HandlePrevious"
                    disabled="@(CurrentIndex == 0)">
                Back
            </button>
            <button class="tornado-chat__btn tornado-chat__btn--approve"
                    @onclick="HandleNextAsync">
                @(IsLastQuestion ? "Submit" : "Next")
            </button>
        </div>
    }
</div>

@code {
    private const string CustomSelectionToken = "__custom__";

    [Parameter] public QuestionInteractionRequest Request { get; set; } = default!;
    [Parameter] public EventCallback<AskQuestionsInteractionResponse> OnSubmit { get; set; }

    private readonly Dictionary<string, string?> _textAnswers = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string?> _singleChoiceSelections = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, HashSet<string>> _multiSelectSelections = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string?> _customValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool?> _yesNoAnswers = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string?> _numberAnswers = new(StringComparer.OrdinalIgnoreCase);

    private string? _requestId;
    private string? _validationError;
    private int CurrentIndex { get; set; }

    private InteractiveQuestionDefinition? CurrentQuestion => Request.Interaction.Questions.Count == 0
        ? null
        : Request.Interaction.Questions[CurrentIndex];

    private bool IsLastQuestion => CurrentIndex >= Request.Interaction.Questions.Count - 1;

    protected override void OnParametersSet()
    {
        if (_requestId == Request.Id)
            return;

        _requestId = Request.Id;
        CurrentIndex = 0;
        _validationError = null;
        _textAnswers.Clear();
        _singleChoiceSelections.Clear();
        _multiSelectSelections.Clear();
        _customValues.Clear();
        _yesNoAnswers.Clear();
        _numberAnswers.Clear();
    }

    private void HandlePrevious()
    {
        if (CurrentIndex > 0)
        {
            CurrentIndex--;
            _validationError = null;
        }
    }

    private async Task HandleNextAsync()
    {
        if (CurrentQuestion is null)
            return;

        if (!TryValidateQuestion(CurrentQuestion, out string? error))
        {
            _validationError = error;
            return;
        }

        _validationError = null;

        if (!IsLastQuestion)
        {
            CurrentIndex++;
            return;
        }

        AskQuestionsInteractionResponse response = new()
        {
            Answers = Request.Interaction.Questions.Select(BuildAnswer).ToList(),
        };

        await OnSubmit.InvokeAsync(response);
    }

    private InteractiveQuestionAnswer BuildAnswer(InteractiveQuestionDefinition question)
    {
        InteractiveQuestionAnswer answer = new()
        {
            Key = question.Key,
            Type = question.Type,
        };

        switch (question.Type)
        {
            case InteractiveQuestionInputType.SingleChoice:
                string? selection = GetSingleChoiceSelection(question.Key);
                if (selection == CustomSelectionToken)
                {
                    answer.TextValue = GetCustomValue(question.Key)?.Trim();
                    answer.UsedCustomAnswer = !string.IsNullOrWhiteSpace(answer.TextValue);
                }
                else
                {
                    answer.TextValue = selection;
                }
                break;

            case InteractiveQuestionInputType.MultiSelect:
                answer.SelectedValues = GetMultiSelectValues(question.Key);
                string? custom = GetCustomValue(question.Key)?.Trim();
                if (!string.IsNullOrWhiteSpace(custom))
                {
                    answer.SelectedValues.Add(custom);
                    answer.UsedCustomAnswer = true;
                }
                break;

            case InteractiveQuestionInputType.YesNo:
                answer.BooleanValue = GetYesNoAnswer(question.Key);
                break;

            case InteractiveQuestionInputType.Number:
                if (decimal.TryParse(GetNumberValue(question.Key), out decimal numberValue))
                    answer.NumberValue = numberValue;
                break;

            default:
                answer.TextValue = GetTextValue(question.Key)?.Trim();
                break;
        }

        return answer;
    }

    private bool TryValidateQuestion(InteractiveQuestionDefinition question, out string? error)
    {
        error = null;

        switch (question.Type)
        {
            case InteractiveQuestionInputType.SingleChoice:
                string? selection = GetSingleChoiceSelection(question.Key);
                if (string.IsNullOrWhiteSpace(selection))
                {
                    if (question.Required)
                        error = "Select an option to continue.";
                    return error is null;
                }

                if (selection == CustomSelectionToken && string.IsNullOrWhiteSpace(GetCustomValue(question.Key)))
                {
                    error = "Enter a custom answer to continue.";
                    return false;
                }
                return true;

            case InteractiveQuestionInputType.MultiSelect:
                bool hasSelectedOptions = GetMultiSelectValues(question.Key).Count > 0;
                bool hasCustom = !string.IsNullOrWhiteSpace(GetCustomValue(question.Key));
                if (question.Required && !hasSelectedOptions && !hasCustom)
                {
                    error = "Select at least one option to continue.";
                    return false;
                }
                return true;

            case InteractiveQuestionInputType.YesNo:
                if (question.Required && GetYesNoAnswer(question.Key) is null)
                {
                    error = "Choose yes or no to continue.";
                    return false;
                }
                return true;

            case InteractiveQuestionInputType.Number:
                string? rawNumber = GetNumberValue(question.Key);
                if (string.IsNullOrWhiteSpace(rawNumber))
                {
                    if (question.Required)
                        error = "Enter a numeric value to continue.";
                    return error is null;
                }

                if (!decimal.TryParse(rawNumber, out decimal numberValue))
                {
                    error = "Enter a valid number.";
                    return false;
                }

                if (question.MinValue is not null && numberValue < question.MinValue.Value)
                {
                    error = $"Value must be at least {question.MinValue.Value}.";
                    return false;
                }

                if (question.MaxValue is not null && numberValue > question.MaxValue.Value)
                {
                    error = $"Value must be at most {question.MaxValue.Value}.";
                    return false;
                }
                return true;

            default:
                if (question.Required && string.IsNullOrWhiteSpace(GetTextValue(question.Key)))
                {
                    error = "Enter a value to continue.";
                    return false;
                }
                return true;
        }
    }

    private string? GetTextValue(string key) => _textAnswers.TryGetValue(key, out string? value) ? value : null;
    private void SetTextValue(string key, string? value) => _textAnswers[key] = value;

    private string? GetSingleChoiceSelection(string key) => _singleChoiceSelections.TryGetValue(key, out string? value) ? value : null;
    private void SetSingleChoiceSelection(string key, string? value) => _singleChoiceSelections[key] = value;

    private List<string> GetMultiSelectValues(string key)
    {
        if (_multiSelectSelections.TryGetValue(key, out HashSet<string>? values))
            return values.ToList();

        return [];
    }

    private bool IsMultiSelectChecked(string key, string value)
    {
        return _multiSelectSelections.TryGetValue(key, out HashSet<string>? selected) && selected.Contains(value);
    }

    private void SetMultiSelectOption(string key, string value, bool isSelected)
    {
        if (!_multiSelectSelections.TryGetValue(key, out HashSet<string>? selected))
        {
            selected = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            _multiSelectSelections[key] = selected;
        }

        if (isSelected)
            selected.Add(value);
        else
            selected.Remove(value);
    }

    private string? GetCustomValue(string key) => _customValues.TryGetValue(key, out string? value) ? value : null;
    private void SetCustomValue(string key, string? value) => _customValues[key] = value;

    private bool? GetYesNoAnswer(string key) => _yesNoAnswers.TryGetValue(key, out bool? value) ? value : null;
    private void SetYesNoAnswer(string key, bool? value) => _yesNoAnswers[key] = value;

    private string? GetNumberValue(string key) => _numberAnswers.TryGetValue(key, out string? value) ? value : null;
    private void SetNumberValue(string key, string? value) => _numberAnswers[key] = value;
}