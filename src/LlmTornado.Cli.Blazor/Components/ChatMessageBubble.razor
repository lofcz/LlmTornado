@using Markdig

<div class="chat-bubble @RoleClass @(Message.IsError ? "chat-bubble--error" : "")">
    <div class="chat-bubble__content">
        @if (Message.Role == ChatUiRole.User)
        {
            <p>@Message.Content</p>

            @if (Message.Files.Count > 0)
            {
                <div class="chat-bubble__files" style="display: flex; flex-direction: column; gap: 8px;">
                    @if (Message.Files.Any(f => f.IsImage))
                    {
                        <div class="chat-bubble__images" style="display: flex; flex-wrap: wrap; gap: 8px;">
                            @foreach (var file in Message.Files.Where(f => f.IsImage))
                            {
                                <img src="data:@file.MimeType;base64,@file.Base64" alt="@file.FileName" class="chat-bubble__image-preview" style="max-width: 400px; max-height: 600px; width: 100%; object-fit: contain; border-radius: 8px; display: block;" />
                            }
                        </div>
                    }

                    <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                        @foreach (var file in Message.Files)
                        {
                            <span class="chat-bubble__file-chip">
                                @FileIcon(file) @file.FileName
                                <span class="chat-bubble__file-size">(@file.FormattedSize)</span>
                            </span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            @* Assistant messages rendered as markdown *@
            <div class="chat-bubble__markdown">
                @((MarkupString)Markdown.ToHtml(Message.Content, Pipeline))
            </div>

            @if (Message.IsStreaming)
            {
                <span class="chat-bubble__cursor">▊</span>
            }
        }
    </div>

    <div class="chat-bubble__meta">
        <span class="chat-bubble__time">
            @Message.Timestamp.ToLocalTime().ToString("HH:mm")
        </span>
    </div>

    @if (Message.Role == ChatUiRole.User && Message.TokenTelemetry is { } userTokens && userTokens.HasPreflight)
    {
        <div class="chat-bubble__meta" style="margin-top: 6px; display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; opacity: 0.8;">
            @if (userTokens.ContextTokensBeforeInput is not null)
            {
                <span title="Tokens already in context before this input was added.">Context: @userTokens.ContextTokensBeforeInput</span>
            }

            @if (userTokens.RequestTokensBeforeSend is not null)
            {
                <span title="Total request tokens before the model call.">Request: @userTokens.RequestTokensBeforeSend</span>
            }

            @if (userTokens.ContextWindowTokens is not null && userTokens.ContextWindowUtilization is not null)
            {
                <span title="Context window utilization before the request was sent.">Window: @userTokens.RequestTokensBeforeSend / @userTokens.ContextWindowTokens (@FormatPercent(userTokens.ContextWindowUtilization.Value))</span>
            }

            @if (!string.IsNullOrWhiteSpace(userTokens.CountingMethod))
            {
                <span title="How the preflight count was computed.">@userTokens.CountingMethod</span>
            }
        </div>
    }

    @if (Message.Role == ChatUiRole.Assistant && Message.TokenTelemetry is { } assistantTokens && assistantTokens.HasUsage)
    {
        <div class="chat-bubble__meta" style="margin-top: 6px; display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; opacity: 0.8;">
            <span title="Accumulated provider-reported usage for this assistant turn.">Usage: @assistantTokens.ActualInputTokens in / @assistantTokens.ActualOutputTokens out / @assistantTokens.ActualTotalTokens total</span>

            @if (assistantTokens.ActualRequestCount > 1)
            {
                <span title="Number of model requests made while processing this turn.">Requests: @assistantTokens.ActualRequestCount</span>
            }

            @if (assistantTokens.CompletionReasoningTokens is not null)
            {
                <span title="Reasoning tokens reported for this turn.">Reasoning: @assistantTokens.CompletionReasoningTokens</span>
            }

            @if (assistantTokens.CacheReadTokens is not null)
            {
                <span title="Prompt tokens served from provider cache.">Cache read: @assistantTokens.CacheReadTokens</span>
            }

            @if (assistantTokens.CacheCreationTokens is not null)
            {
                <span title="Prompt tokens written into provider cache.">Cache write: @assistantTokens.CacheCreationTokens</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ChatUiMessage Message { get; set; } = default!;

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private string RoleClass => Message.Role switch
    {
        ChatUiRole.User => "chat-bubble--user",
        ChatUiRole.System => "chat-bubble--system",
        _ => "chat-bubble--assistant"
    };

    private static string FileIcon(ChatUiFile file) => file switch
    {
        { IsImage: true } => "🖼",
        { IsDocument: true } => "📄",
        { IsAudio: true } => "🎵",
        _ => "📎"
    };

    private static string FormatPercent(double value)
    {
        return value.ToString("P0");
    }
}
